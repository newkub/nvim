{
	"name": "webconfig",
	"packageManager": "bun@1.3.5",
	"engines": {
		"bun": ">=1.3.5"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"typecheck": "nuxi typecheck",
		"lint": "bun run typecheck",
		"lint:biome": "biome lint --write .",
		"format": "biome format --write .",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "bun -e \"console.log('No tests configured yet')\"",
		"verify": "bun run format && bun run lint && bun run test && bun run build",
		"watch": "bun --watch verify"
	},
	"dependencies": {
		"@nuxt/icon": "^2.1.1",
		"@nuxtjs/color-mode": "^4.0.0",
		"@pinia/nuxt": "^0.11.3",
		"@unocss/nuxt": "^66.5.12",
		"@vueuse/nuxt": "^14.1.0",
		"nuxt": "^4.2.2",
		"vue": "^3.5.26",
		"vue-router": "^4.6.4",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4"
	}
}
